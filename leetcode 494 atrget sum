class Solution {
    static int tum;
    int find(int i,int sum,int [] nums,int target,int dp[][]){
if(i==nums.length && sum==target)
return 1;
else if(i==nums.length)
return 0;
if(dp[i][sum+tum]!=-1)
return dp[i][sum+tum];
        return dp[i][sum+tum]=find(i+1,sum+nums[i],nums,target,dp)+find(i+1,sum-nums[i],nums,target,dp);
    }
    public int findTargetSumWays(int[] nums, int target) {
        tum=0;
        for(int ele: nums)
        tum+=ele;
        int [][] dp=new int[nums.length][2*tum+1];
        for(int i=0;i<nums.length;i++){
            for(int j=0;j<dp[0].length;j++){
                dp[i][j]=-1;
            }
        }
return find(0,0,nums,target,dp);

    }
}

